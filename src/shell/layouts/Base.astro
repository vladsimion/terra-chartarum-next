---
import '../fonts.js';
import '../styles/tokens.css';
import '../styles/base.css';
import { breadcrumbs } from '../breadcrumbs.js';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description?: string;
  /** BCP 47 language of the page content; becomes the lang attribute (FR-018). */
  lang?: string;
  /** The page's name in the breadcrumb; defaults to the part of the title before " | ". */
  crumb?: string;
}

const { title, description, lang = 'en', crumb } = Astro.props;
const trail = breadcrumbs(Astro.url.pathname, crumb ?? title.split(' | ')[0] ?? title);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header path={Astro.url.pathname} />
    <main id="main" tabindex="-1">
      <Breadcrumbs items={trail} />
      <slot />
    </main>
    <Footer />
  </body>
</html>
