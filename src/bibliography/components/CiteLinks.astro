---
import type { CiteFiles } from '../cite-paths.js';

interface Props {
  label: string;
  files: CiteFiles;
}

const { label, files } = Astro.props;
const links = [
  { name: 'BibTeX', href: files.bibtex },
  { name: 'RIS', href: files.ris },
  { name: 'CSL-JSON', href: files.json },
];
---

<nav class="citation-export" aria-label={label}>
  <ul>
    {links.map((l) => <li><a href={l.href}>{l.name}</a></li>)}
  </ul>
</nav>

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: var(--space-3) 0 var(--space-5);
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    color: var(--accent);
  }
</style>
