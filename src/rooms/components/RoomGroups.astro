---
import type { Item, RoomView } from '../views.js';

interface Props {
  room: RoomView;
}
const { room } = Astro.props;
const hasEssays = room.primaryEssays.length + room.secondaryEssays.length > 0;
const groups: { id: string; heading: string; items: Item[] }[] = [
  { id: 'maps', heading: 'Maps', items: room.maps },
  { id: 'layers', heading: 'Layers', items: room.layers },
].filter((g) => g.items.length > 0);
---

{hasEssays ? (
  <section data-group="essays" aria-labelledby="room-essays">
    <h2 id="room-essays">Essays</h2>
    {[{ heading: 'Primary', items: room.primaryEssays }, { heading: 'Secondary', items: room.secondaryEssays }]
      .filter((g) => g.items.length > 0)
      .map((g) => (
        <>
          <h3>{g.heading}</h3>
          <ul>
            {g.items.map((item) => <li><a href={item.href}>{item.title}</a></li>)}
          </ul>
        </>
      ))}
  </section>
) : (
  <p data-in-preparation>Essays for this room are in preparation.</p>
)}
{groups.map((g) => (
  <section data-group={g.id} aria-labelledby={`room-${g.id}`}>
    <h2 id={`room-${g.id}`}>{g.heading}</h2>
    <ul>
      {g.items.map((item) => <li><a href={item.href}>{item.title}</a></li>)}
    </ul>
  </section>
))}

<style>
  ul {
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
  }

  li a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
  }
</style>
