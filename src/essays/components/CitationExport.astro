---
import { pageModel } from '../locals.js';

const base = `/essays/${pageModel(Astro.locals).essay.slug}/`;
const files = [
  { label: 'BibTeX', file: 'cite.bib' },
  { label: 'RIS', file: 'cite.ris' },
  { label: 'CSL-JSON', file: 'cite.json' },
];
---

<nav class="citation-export" aria-label="Cite this essay">
  <ul>
    {files.map(({ label, file }) => <li><a href={`${base}${file}`}>{label}</a></li>)}
  </ul>
</nav>

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: var(--space-5) 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    color: var(--accent);
  }
</style>
