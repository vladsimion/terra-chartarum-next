---
import { pageModel } from '../locals.js';

const { rooms } = pageModel(Astro.locals);
---

{rooms.length > 0 && (
  <nav class="rooms" aria-label="Rooms">
    <h2 class="label">Rooms</h2>
    <ul>
      {rooms.map((room) => (
        <li data-primary={room.primary ? '' : undefined}><a href={room.href}>{room.title}</a></li>
      ))}
    </ul>
  </nav>
)}

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li[data-primary] a {
    font-weight: 700;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    color: var(--accent);
  }

  .label {
    font-size: var(--step-0);
  }
</style>
