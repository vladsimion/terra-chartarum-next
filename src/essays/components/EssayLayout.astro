---
import Base from '../../shell/layouts/Base.astro';
import { pageModel } from '../locals.js';
import Bibliography from './Bibliography.astro';
import Notes from './Notes.astro';
import RelatedEssays from './RelatedEssays.astro';
import RoomLinks from './RoomLinks.astro';

/*
 * The frame of an essay page (spec 003 US1): title, byline and thesis first, then the argument (the
 * MDX body in the slot), then notes, bibliography, rooms and related essays. The accent is the
 * record's own, through the shell's Base layout.
 */
const { essay } = pageModel(Astro.locals);
const authors = Array.isArray(essay.authors) ? (essay.authors as string[]).join(', ') : '';
const published = typeof essay.published_on === 'string' ? essay.published_on : null;
---

<Base
  title={`${essay.title} | Terra Chartarum`}
  crumb={String(essay.title)}
  accent={typeof essay.accent === 'string' ? essay.accent : undefined}
  description={typeof essay.question === 'string' ? essay.question : undefined}
>
  <article class="essay">
    <div class="essay-head">
      <h1>{essay.title}</h1>
      <p class="byline">
        {authors}
        {published && <> · <time datetime={published}>{published}</time></>}
      </p>
      {typeof essay.thesis === 'string' && (
        <p class="thesis" data-testid="thesis">
          <span class="thesis-label">Thesis</span>
          {essay.thesis}
        </p>
      )}
    </div>
    <div class="body"><slot /></div>
    <Notes />
    <Bibliography />
    <RoomLinks />
    <RelatedEssays />
  </article>
</Base>

<style>

  /*
   * The vocabulary an essay's drawings are inked with (spec 009 research R4): six inks and three
   * hands, every one a token, so a drawing carries no colour of its own and the lapidarium's squeeze
   * can exchange them all at once by rewriting the `--plate-*` properties. Global, because the
   * drawings are written in the body and appear inside a stone plate, a comparison or on their own.
   * A drawing's own font sizes stay as SVG attributes: they are in the drawing's units and scale
   * with it, which a rem token cannot do.
   */
  /*
   * The ported drawings need five inks and three hands. A drawing's own font sizes stay as SVG
   * attributes: they are in the drawing's units and scale with it, which a rem token cannot do
   * (the Timeline's positions are data in the same way).
   */
  /* A stroke in the paper's own tone: a gap drawn over an inked line, not an ink of its own. */
  :global(.plate-paper-rule) {
    fill: none;
    stroke: var(--plate-paper, var(--panel-raised));
  }

  :global(.plate-paper) {
    fill: var(--plate-paper, var(--panel-raised));
  }

  :global(.plate-water-text) {
    fill: var(--plate-water, var(--accent));
  }

  :global(.plate-mark) {
    fill: var(--plate-mark, var(--accent));
  }

  :global(.plate-mark-rule) {
    fill: none;
    stroke: var(--plate-mark, var(--accent));
  }

  /* The bars struck over a classified sheet: the strongest ink the plate has. */
  :global(.plate-redacted) {
    fill: var(--plate-ink, var(--ink));
  }

  :global(.plate-ground) {
    fill: var(--plate-ground, var(--panel));
  }

  :global(.plate-accent) {
    fill: var(--plate-accent, var(--accent));
  }

  :global(.plate-accent-rule) {
    fill: none;
    stroke: var(--plate-accent, var(--accent));
  }

  :global(.plate-cold) {
    fill: var(--plate-cold, var(--accent-indigo));
  }

  :global(.plate-cold-rule) {
    fill: none;
    stroke: var(--plate-cold, var(--accent-indigo));
  }

  :global(.plate-muted-rule) {
    fill: none;
    stroke: var(--plate-ink-muted, var(--ink-muted));
  }

  :global(.plate-muted) {
    fill: var(--plate-ink-muted, var(--ink-muted));
  }

  :global(.plate-caps) {
    font-family: var(--font-display);
  }

  :global(.plate-label) {
    font-family: var(--font-body);
    font-style: italic;
  }

  :global(.plate-mono) {
    font-family: var(--font-mono);
  }

  /* The drawing's vocabulary: a carved rule, a filled mark, a watercourse and a cut letter. */
  :global(.plate-rule) {
    fill: none;
    stroke: var(--plate-ink, var(--ink));
    stroke-width: 1.4;
  }

  :global(.plate-ink) {
    fill: var(--plate-ink, var(--ink));
    stroke: none;
  }

  :global(.plate-water) {
    fill: none;
    stroke: var(--plate-water, var(--accent));
    stroke-width: 2;
  }

  :global(.plate-text) {
    fill: var(--plate-ink, var(--ink));
    font-family: var(--font-mono);
    font-size: var(--step--2);
  }
  h1 {
    padding-bottom: var(--space-3);
    border-bottom: 3px solid var(--accent);
  }

  .byline {
    color: var(--ink-muted);
  }

  .thesis {
    max-width: var(--prose-max);
    margin: var(--space-5) 0;
    padding-inline-start: var(--space-4);
    border-inline-start: 3px solid var(--accent);
    font-size: var(--step-1);
  }

  .thesis-label {
    display: block;
    color: var(--ink-muted);
    font-size: var(--step--1);
    text-transform: uppercase;
  }

  .body {
    max-width: var(--prose-max);
  }
</style>
