---
import type { FieldRowView } from '../record-view.js';

interface Props {
  row: FieldRowView;
}

const { row } = Astro.props;
const text = row.value === null ? (row.statusText ?? 'Unknown') : Array.isArray(row.value) ? row.value.join(', ') : row.value;
---

<div class="field" data-field={row.field} data-status={row.status}>
  <dt>{row.label}</dt>
  <dd>
    {text}
    {row.basis && <span class="basis">({row.basis})</span>}
  </dd>
</div>

<style>
  .field {
    display: grid;
    grid-template-columns: minmax(8rem, 12rem) 1fr;
    gap: var(--space-1) var(--space-4);
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--line);
  }

  dt {
    color: var(--ink-muted);
  }

  dd {
    margin: 0;
  }

  [data-status]:not([data-status='recorded']) dd {
    color: var(--ink-muted);
    font-style: italic;
  }

  .basis {
    color: var(--ink-muted);
    font-size: var(--step--1);
  }

  @media (max-width: 36rem) {
    .field {
      grid-template-columns: 1fr;
    }
  }
</style>
