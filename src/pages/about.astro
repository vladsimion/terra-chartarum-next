---
import { getEntry, render } from 'astro:content';
import Base from '../shell/layouts/Base.astro';

/* The About page (spec 002 US5). Its copy is draft until the author sets `draft: false` in src/content/pages/about.md. */
const page = await getEntry('pages', 'about');
if (!page) throw new Error('src/content/pages/about.md is missing');
const { Content } = await render(page);
---

<Base title={`${page.data.title} | Terra Chartarum`} description={page.data.description} lang={page.data.lang}>
  <h1>{page.data.title}</h1>
  <div class="prose" data-draft={page.data.draft ? '' : undefined}>
    <Content />
  </div>
</Base>
