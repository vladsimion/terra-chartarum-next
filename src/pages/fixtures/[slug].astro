---
import { FIXTURE_ESSAYS, LONG_TITLE_FIXTURE, TEST_ONLY_FIXTURES } from '../../shell/fixture-essays.js';
import Base from '../../shell/layouts/Base.astro';

/*
 * Test-only pages: two neutral "essays" with different accent slots, used by the snapshot and
 * accessibility specs (spec 002 T027, T032). They are generated only when SHELL_FIXTURES=1 and are
 * never part of a production build.
 */

export function getStaticPaths() {
  if (process.env.SHELL_FIXTURES !== '1') return [];
  const essays = [...FIXTURE_ESSAYS, LONG_TITLE_FIXTURE].map((f) => ({ params: { slug: f.slug }, props: { fixture: f as { slug: string; title: string; accent: string } } }));
  const testOnly = TEST_ONLY_FIXTURES.map((slug) => ({ params: { slug }, props: { fixture: { slug, title: slug, accent: 'gold' } } }));
  return [...essays, ...testOnly];
}

const { fixture } = Astro.props;
const kind = fixture.slug;

// a deterministic ~480 KB payload that does not compress away: the "page over the JavaScript budget"
let seed = 123456789;
let payload = '';
if (kind === 'budget') {
  for (let i = 0; i < 80000; i++) {
    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
    payload += (seed >>> 8).toString(16).padStart(6, '0');
  }
}
---

<Base title={`${fixture.title} | Terra Chartarum`} crumb={fixture.title} accent={fixture.accent}>
  {kind === 'bad-a11y' && (
    <article>
      <h1>Inaccessible test page</h1>
      <button></button>
      <img src="/favicon.svg" />
    </article>
  )}
  {kind === 'budget' && (
    <article>
      <h1>Over-budget test page</h1>
      <p>This page ships far more JavaScript than the budget allows.</p>
      <script is:inline set:html={`window.__payload="${payload}";`}></script>
    </article>
  )}
  {kind !== 'bad-a11y' && kind !== 'budget' && (
  <article>
    <h1>{fixture.title}</h1>
    <p>
      This is a neutral test page. It carries no scholarly claim. It exists so that the shell, its typography and its
      accent can be checked in both colour schemes.
    </p>
    <h2>A second heading</h2>
    <p>
      Running text with a <a href="/essays/">link to the essays</a>, a very long unbroken word
      (Pneumonoultramicroscopicsilicovolcanoconiosis) and Greek and extended Latin letters: Γεωγραφία, Ptolemaios, Alba Iulia, Ștefan.
    </p>
    <blockquote>
      <p>A quotation, to see how the accent and the muted ink sit together.</p>
    </blockquote>
    <p class="note">A note in the muted ink, as a caption or metadata would be.</p>
  </article>
  )}
</Base>

<style>
  h1 {
    padding-bottom: var(--space-3);
    border-bottom: 3px solid var(--accent);
  }

  blockquote {
    margin-inline: 0;
    padding-inline-start: var(--space-4);
    border-inline-start: 3px solid var(--accent);
  }

  .note {
    color: var(--ink-muted);
  }

  a {
    color: var(--accent);
  }
</style>
