---
import { loadEssaySite } from '../../essays/site-data.js';
import { indexView } from '../../rooms/views.js';
import Base from '../../shell/layouts/Base.astro';

/*
 * The Rooms index (spec 007 US1): the seven rooms in their fixed order, each with its short
 * description. A room is a conceptual path through the material, never a folder; the page is static
 * HTML built from the public records and ships no script.
 */
const { records } = await loadEssaySite();
const rooms = indexView(records);
---

<Base title="Rooms | Terra Chartarum" description="Seven ways into the material: earth, map, city, border, road, archive and theatre.">
  <h1>Rooms</h1>
  <p class="intro">Seven ways into the material. Each room gathers the essays, maps and Atlas layers that take up one kind of human relationship to space.</p>
  <ol class="rooms">
    {rooms.map((room) => (
      <li data-room={room.slug} data-draft={room.draft ? '' : undefined}>
        <a href={room.href}>{room.name}</a>
        <p>{room.shortDescription}</p>
      </li>
    ))}
  </ol>
</Base>

<style>
  .rooms {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .rooms li {
    padding: var(--space-3) 0;
    border-top: 1px solid var(--line);
  }

  .rooms a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    font-size: var(--step-1);
    font-weight: 600;
  }

  .rooms p {
    margin: 0;
    color: var(--ink-muted);
  }

  @media (min-width: 40rem) {
    .rooms {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-5);
    }
  }
</style>
