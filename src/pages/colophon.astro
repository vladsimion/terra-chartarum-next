---
import { getEntry, render } from 'astro:content';
import Base from '../shell/layouts/Base.astro';

/* The Colophon (spec 002 US5); the footer's licences link is its #licences section. Draft copy until `draft: false` in src/content/pages/colophon.md. */
const page = await getEntry('pages', 'colophon');
if (!page) throw new Error('src/content/pages/colophon.md is missing');
const { Content } = await render(page);
---

<Base title={`${page.data.title} | Terra Chartarum`} description={page.data.description} lang={page.data.lang}>
  <h1>{page.data.title}</h1>
  <div class="prose" data-draft={page.data.draft ? '' : undefined}>
    <Content />
  </div>
</Base>
