---
import { THEME_LABELS, THEME_VALUES } from '../../registry/schemas/atlas-values.js';
import { HANDBOOK_LINKS } from '../handbook-links.js';
import { kindOf } from '../labels.js';
import type { IndexLayer } from '../types.js';

interface Props {
  layers: IndexLayer[];
}

/*
 * The catalogue as HTML (spec 005 FR-021): every public layer, grouped by theme, with no link to
 * a layer's data. The add button waits for a script (`hidden`); without one the list is still a
 * complete, readable catalogue.
 */
const { layers } = Astro.props;
const groups = THEME_VALUES.map((theme) => ({ theme, label: THEME_LABELS[theme], layers: layers.filter((l) => l.theme === theme) })).filter((g) => g.layers.length > 0);
---

<section id="catalogue" class="catalogue" aria-label="Catalogue">
  <h2>Catalogue</h2>
  <p><a href={HANDBOOK_LINKS.themes}>How the layers are organised (Handbook)</a></p>
  <div class="controls" data-controls hidden>
    <label for="atlas-search">Search layers</label>
    <input id="atlas-search" type="search" autocomplete="off" />
    <fieldset>
      <legend>Browse by</legend>
      <label><input type="radio" name="lens" value="theme" checked /> Themes</label>
      <label><input type="radio" name="lens" value="collection" /> Collections</label>
      <label><input type="radio" name="lens" value="room" /> Rooms</label>
    </fieldset>
    <label><input id="atlas-relevant" type="checkbox" /> Only show layers relevant to this year</label>
    <p role="status" data-catalogue-status></p>
  </div>
  <div data-catalogue-list>
  {
    groups.map((group) => (
      <section data-group={`theme:${group.theme}`}>
        <h3>{group.label}</h3>
        <ul>
          {group.layers.map((layer) => (
            <li data-layer={layer.slug} data-from={layer.envelope.from} data-to={layer.envelope.to}>
              <span class="title">{layer.title}</span>
              <span class="kind">{kindOf(layer)}</span>
              <span class="envelope">{layer.envelope.from} to {layer.envelope.to}</span>
              <button type="button" data-activate={layer.slug} aria-label={`Add ${layer.title} to the map`} hidden>
                Add to map
              </button>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
  </div>
</section>

<style>
  fieldset {
    margin: var(--space-3) 0;
    padding: 0;
    border: 0;
  }

  .controls label {
    display: block;
  }

  /* the list is rebuilt by script, so its parts are matched globally under the catalogue */
  .catalogue :global(ul) {
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
  }

  .catalogue :global(li) {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0 var(--space-3);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--line);
  }

  .catalogue :global(.title) {
    font-weight: 600;
  }

  .catalogue :global(.kind),
  .catalogue :global(.envelope) {
    color: var(--ink-muted);
    font-size: var(--step--1);
  }

  .catalogue :global(li button) {
    grid-column: 2;
    grid-row: 1 / span 3;
    align-self: center;
  }
</style>
