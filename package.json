{
  "name": "terra-chartarum-next",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "registry": "tsx src/registry/cli.ts",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint:css": "stylelint \"src/**/*.{css,astro}\"",
    "test:e2e": "playwright test",
    "test:e2e:essays": "playwright test --config playwright.essays.config.ts",
    "test:e2e:collection": "playwright test --config playwright.collection.config.ts",
    "test:e2e:atlas": "playwright test --config playwright.atlas.config.ts",
    "lhci": "npx --yes @lhci/cli@0.15.1 autorun",
    "shell:check": "tsx scripts/shell-check.ts"
  },
  "dependencies": {
    "@allmaps/maplibre": "1.0.0-beta.44",
    "@astrojs/mdx": "8.0.2",
    "@citation-js/core": "0.9.0",
    "@citation-js/plugin-bibtex": "0.9.0",
    "@citation-js/plugin-csl": "0.9.0",
    "@citation-js/plugin-ris": "0.9.0",
    "@fontsource-variable/cinzel": "5.3.0",
    "@fontsource-variable/crimson-pro": "5.3.0",
    "@fontsource-variable/eb-garamond": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "astro": "7.3.5",
    "edtf": "^4.11.1",
    "flatgeobuf": "4.5.0",
    "maplibre-gl": "6.11.2",
    "openseadragon": "6.1.1",
    "pmtiles": "4.5.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "node-html-parser": "9.0.4",
    "playwright-core": "1.63.0",
    "postcss": "8.5.28",
    "postcss-html": "2.0.0",
    "stylelint": "17.16.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "4.151.1"
  }
}
