{
  "name": "terra-chartarum",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Terra Chartarum successor: spec-driven historical atlas and scholarly cartographic publication",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
