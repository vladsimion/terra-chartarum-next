// Cloudflare Workers static-assets deployment (ADR 0012).
// The site is static output only: no Worker script, no server adapter.
// Wrangler uploads ./dist as-is; _headers and _redirects in public/ are honoured.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "terra-chartarum-next",
  "compatibility_date": "2026-10-17",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Required by `wrangler preview`, which Workers Builds runs for non-production
  // branches. Empty: Previews inherit assets and compatibility settings from the top level.
  "previews": {}
}
